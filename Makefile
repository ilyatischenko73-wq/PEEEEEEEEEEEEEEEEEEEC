# ============================================================
# PEEC / PARTIAL EQUIVALENT CIRCUIT
# Makefile
#
# Режимы:
#
#   make
#       обычная release-сборка без тестов
#
#   make debug
#       отладочная сборка без TEST
#
#   make test
#       настоящие регрессионные тесты (Makefile.tests)
#
#   make testrcs
#       отдельная RCS-сборка через src/main_rcs.c
#
#   make run
#       запуск обычной сборки
#
#   make run-test
#       запуск регрессионных тестов
#
#   make run-rcs
#       сборка RCS и запуск
#
# ============================================================


# ------------------------------------------------------------
# Компилятор
# ------------------------------------------------------------

CC := gcc


# ------------------------------------------------------------
# Исполняемые файлы
# ------------------------------------------------------------

TARGET := PeecSolver

RCS_TARGET := PeecRcsTest


# ------------------------------------------------------------
# Директории
# ------------------------------------------------------------

SRC_DIR := src
INC_DIR := include
BUILD_DIR := build


# ------------------------------------------------------------
# Базовые флаги
# ------------------------------------------------------------

COMMON_CFLAGS := \
	-std=c17 \
	-Wall \
	-Wextra \
	-Wpedantic \
	-fopenmp \
	-MMD \
	-MP \
	-I$(INC_DIR)


# ------------------------------------------------------------
# Release-флаги
# ------------------------------------------------------------

RELEASE_CFLAGS := \
	-O3 \
	-march=native


# ------------------------------------------------------------
# Debug-флаги
# ------------------------------------------------------------

DEBUG_CFLAGS := \
	-O0 \
	-g3


# ------------------------------------------------------------
# RCS-флаги
# ------------------------------------------------------------
#
# Здесь НЕТ -DTEST.
#
# Поэтому main_rcs.c запускает только реальную RCS-задачу,
# без старых self-test.
# ------------------------------------------------------------

RCS_CFLAGS := \
	-O3 \
	-march=native \
	-g


# ------------------------------------------------------------
# По умолчанию release
# ------------------------------------------------------------

CFLAGS := $(COMMON_CFLAGS) $(RELEASE_CFLAGS)


# ------------------------------------------------------------
# Линковка
# ------------------------------------------------------------

LDFLAGS := \
	-fopenmp \
	-lm


# ============================================================
# ОБЩИЕ ИСХОДНЫЕ ФАЙЛЫ
# ============================================================
#
# Здесь специально НЕТ:
#
#     src/main.c
#     src/main_rcs.c
#
# Оба main подключаются отдельно.
# ============================================================

COMMON_SOURCES := \
	$(SRC_DIR)/config.c \
	$(SRC_DIR)/physics/incident_field.c \
	$(SRC_DIR)/physics/scattering.c \
	$(SRC_DIR)/physics/rcs.c \
	$(SRC_DIR)/physics/lightning.c \
	$(SRC_DIR)/physics/aperture_coupling.c\
	$(SRC_DIR)/physics/slot_circuit.c\
	$(SRC_DIR)/mesh/mesh.c \
	$(SRC_DIR)/mesh/mesh_gmsh.c \
	$(SRC_DIR)/mesh/topology.c \
	$(SRC_DIR)/mesh/dual_mesh.c \
	$(SRC_DIR)/math/matrix.c \
	$(SRC_DIR)/math/lu.c \
	$(SRC_DIR)/math/complex_matrix.c \
	$(SRC_DIR)/math/complex_lu.c \
	$(SRC_DIR)/peec/incidence.c \
	$(SRC_DIR)/peec/quadrature.c \
	$(SRC_DIR)/peec/inductance.c \
	$(SRC_DIR)/peec/potential.c \
	$(SRC_DIR)/peec/resistance.c \
	$(SRC_DIR)/solver/harmonic.c\
	$(SRC_DIR)/solver/internal_circuit.c \
	$(SRC_DIR)/solver/transient.c \
	$(SRC_DIR)/io/paraview.c \
	$(SRC_DIR)/io/matrix_export.c



# ------------------------------------------------------------
# Основной main
# ------------------------------------------------------------

MAIN_SOURCE := \
	$(SRC_DIR)/main.c


# ------------------------------------------------------------
# RCS main
# ------------------------------------------------------------

RCS_MAIN_SOURCE := \
	$(SRC_DIR)/main_rcs.c


# ============================================================
# OBJECT-ФАЙЛЫ
# ============================================================

COMMON_OBJECTS := \
	$(patsubst %.c,$(BUILD_DIR)/%.o,$(COMMON_SOURCES))


MAIN_OBJECT := \
	$(patsubst %.c,$(BUILD_DIR)/%.o,$(MAIN_SOURCE))


RCS_MAIN_OBJECT := \
	$(patsubst %.c,$(BUILD_DIR)/%.o,$(RCS_MAIN_SOURCE))


# ------------------------------------------------------------
# Обычный PeecSolver
# ------------------------------------------------------------

OBJECTS := \
	$(MAIN_OBJECT) \
	$(COMMON_OBJECTS)


# ------------------------------------------------------------
# PeecRcsTest
# ------------------------------------------------------------

RCS_OBJECTS := \
	$(RCS_MAIN_OBJECT) \
	$(COMMON_OBJECTS)


# ============================================================
# HEADER-ЗАВИСИМОСТИ
# ============================================================

DEPS := \
	$(COMMON_OBJECTS:.o=.d) \
	$(MAIN_OBJECT:.o=.d) \
	$(RCS_MAIN_OBJECT:.o=.d)


# ============================================================
# ПСЕВДОЦЕЛИ
# ============================================================

.PHONY: \
	all \
	release \
	debug \
	test \
	testrcs \
	run \
	run-test \
	run-rcs \
	clean


# ============================================================
# ОБЫЧНАЯ RELEASE-СБОРКА
# ============================================================

all: $(TARGET)


release: clean
	$(MAKE) \
		CFLAGS="$(COMMON_CFLAGS) $(RELEASE_CFLAGS)" \
		$(TARGET)


# ============================================================
# DEBUG-СБОРКА
# ============================================================

debug: clean
	$(MAKE) \
		CFLAGS="$(COMMON_CFLAGS) $(DEBUG_CFLAGS)" \
		$(TARGET)


# Regression tests use separate build/verification objects.
test:
	$(MAKE) -f Makefile.tests verify


# ============================================================
# RCS-СБОРКА
# ============================================================
#
# Используется:
#
#     src/main_rcs.c
#
# вместо:
#
#     src/main.c
#
#
# -DTEST здесь отсутствует.
# ============================================================

testrcs: clean
	$(MAKE) \
		CFLAGS="$(COMMON_CFLAGS) $(RCS_CFLAGS)" \
		$(RCS_TARGET)


# ============================================================
# ЛИНКОВКА ОСНОВНОЙ ПРОГРАММЫ
# ============================================================

$(TARGET): $(OBJECTS)
	@echo
	@echo "Linking $(TARGET) ..."
	$(CC) $(OBJECTS) -o $(TARGET) $(LDFLAGS)
	@echo
	@echo "Build complete: ./$(TARGET)"
	@echo


# ============================================================
# ЛИНКОВКА RCS-ПРОГРАММЫ
# ============================================================

$(RCS_TARGET): $(RCS_OBJECTS)
	@echo
	@echo "Linking $(RCS_TARGET) ..."
	$(CC) $(RCS_OBJECTS) -o $(RCS_TARGET) $(LDFLAGS)
	@echo
	@echo "RCS build complete: ./$(RCS_TARGET)"
	@echo


# ============================================================
# КОМПИЛЯЦИЯ .c -> .o
# ============================================================

$(BUILD_DIR)/%.o: %.c
	@mkdir -p $(dir $@)
	@echo "Compiling $< ..."
	$(CC) $(CFLAGS) -c $< -o $@


# ============================================================
# АВТОМАТИЧЕСКИЕ HEADER-ЗАВИСИМОСТИ
# ============================================================

-include $(DEPS)


# ============================================================
# ЗАПУСК ОСНОВНОЙ СБОРКИ
# ============================================================

run: $(TARGET)
	./$(TARGET) \
		--task scattering \
		--mesh ./meshes/body_closed.msh \
		--parallel 12


# ============================================================
# TEST + ЗАПУСК
# ============================================================

run-test: test


# ============================================================
# RCS + ЗАПУСК
# ============================================================

run-rcs: testrcs
	./$(RCS_TARGET) \
		--mesh ./meshes/body_closed.msh \
		--parallel 12


# ============================================================
# ОЧИСТКА
# ============================================================

clean:
	@echo "Cleaning build files ..."
	rm -rf $(BUILD_DIR)
	rm -f $(TARGET)
	rm -f $(RCS_TARGET)
